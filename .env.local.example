# Local demo env for the portal app (dashboard/). Copy to .env.local and fill in.
#   cp .env.local.example .env.local
# .env.local is gitignored. Never commit real values.

# ── Database ─────────────────────────────────────────────
# Neon connection string. Shared with the marketing app at the repo root
# (the dashboard reads the marketing `leads` table from the same database).
DATABASE_URL=

# ── Auth (NextAuth v5, firm-owner logins at /login) ──────
# The dashboard runs on 3001 locally; the marketing site takes 3000.
NEXTAUTH_URL=http://localhost:3001
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ── URLs ─────────────────────────────────────────────────
# Public origin of this app (magic links, engagement links, set-password links).
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001
# Public origin of the marketing app; firm websites are served at /sites/<slug>.
MARKETING_SITE_URL=http://localhost:3000

# ── Provisioning (marketing app -> POST /api/internal/provision) ──
# Must match PROVISION_SECRET in the root .env.local.
PROVISION_SECRET=

# ── Nexli admin account ──────────────────────────────────
# Owns Firm Foundation service agreements; firm owners log in to /portal as its clients.
NEXLI_ADMIN_EMAIL=mail@nexli.net
# Used by: node scripts/demo/seed-admin.mjs --env .env.local
ADMIN_INITIAL_PASSWORD=

# ── Email (Resend) ───────────────────────────────────────
# Optional for local demos: without a key, magic links are printed to the
# server log as "[portal magic link] <url>" (non-production only).
RESEND_API_KEY=
# Must be a verified Resend sender on a verified domain.
RESEND_FROM_EMAIL=Nexli Portal <portal@documents.nexli.net>

# ── Anthropic (optional) ─────────────────────────────────
# Claude writes firm website copy during site generation; falls back to templates when unset.
ANTHROPIC_API_KEY=

# ── Stripe (optional for the demo; invoices and payments) ──
STRIPE_SECRET_KEY=sk_test_...
# Platform-account webhook endpoint: /api/webhooks/payments
STRIPE_WEBHOOK_SECRET=
# Connect webhook endpoint ("Events on Connected accounts"): /api/webhooks/connect
STRIPE_CONNECT_WEBHOOK_SECRET=

# ── Supabase Storage (optional; logo upload + client documents) ──
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Misc (optional) ──────────────────────────────────────
# Booking link shown to Foundation firms for the upgrade call.
NEXT_PUBLIC_UPGRADE_BOOKING_URL=
